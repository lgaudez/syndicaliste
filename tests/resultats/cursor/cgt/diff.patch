 def ratio(part, total):
+    """Calcule le rapport entre une partie et un total.
+
+    Args:
+        part: La partie (numérateur).
+        total: Le total (dénominateur).
+
+    Returns:
+        Le quotient part / total.
+    """
     return part / total
 
 
 def somme(liste):
+    """Calcule la somme des éléments d'une liste.
+
+    Args:
+        liste: Iterable de nombres à additionner.
+
+    Returns:
+        La somme des éléments.
+    """
     return sum(liste)
